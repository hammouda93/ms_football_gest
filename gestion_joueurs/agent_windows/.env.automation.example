# L’agent existant continue de fonctionner sans ces options.
# Activez-les uniquement après avoir ajouté les clés dans gestion_joueurs/.env.

# Image de présentation OpenAI
OPENAI_IMAGE_AUTO_GENERATE=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=2048x1152
OPENAI_IMAGE_QUALITY=high

# Animation image-to-video Kling (API Open Platform, pas le plugin interactif)
KLING_AUTO_GENERATE=false
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_MODEL_NAME=kling-v2-6
KLING_MODE=pro
KLING_DURATION_SECONDS=5

# Validation du master et preset d’export Premiere
FFPROBE_EXE=
FINAL_EXPORT_REQUIRE_FFPROBE=true
PREMIERE_EXPORT_PRESET=

# Livraison WhatsApp Cloud API (sinon bouton wa.me + confirmation dans l’app)
WHATSAPP_AUTO_SEND_ENABLED=false
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
