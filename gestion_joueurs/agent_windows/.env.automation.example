# L’agent existant continue de fonctionner sans ces options.
# Activez-les uniquement après avoir ajouté les clés dans gestion_joueurs/.env.

# Image de présentation OpenAI
OPENAI_IMAGE_AUTO_GENERATE=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=2048x1152
OPENAI_IMAGE_QUALITY=high

# Animation image-to-video Kling (API Open Platform, pas le plugin interactif)
KLING_AUTO_GENERATE=false
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_MODEL_NAME=kling-v2-6
KLING_MODE=pro
KLING_DURATION_SECONDS=5

# Validation du master et preset d’export Premiere
FFPROBE_EXE=
FINAL_EXPORT_REQUIRE_FFPROBE=true
PREMIERE_EXPORT_PRESET=

# Upload des Vidéos Highlights finales uniquement.
# Ne modifiez pas les variables YOUTUBE_* : elles restent réservées aux
# abonnements Performance / All Actions.
HIGHLIGHTS_YOUTUBE_STUDIO_CHANNEL_ID=
HIGHLIGHTS_YOUTUBE_CHROME_PROFILE_DIR=D:\YouTube_Highlights_Profile
HIGHLIGHTS_YOUTUBE_CHROME_PROFILE_NAME=Default
HIGHLIGHTS_YOUTUBE_BROWSER_CHANNEL=chrome
HIGHLIGHTS_YOUTUBE_HEADLESS=false
# Facultatif si Chrome n’est pas détecté automatiquement lors du premier login.
HIGHLIGHTS_YOUTUBE_CHROME_EXE=
HIGHLIGHTS_YOUTUBE_UPLOAD_TIMEOUT_MINUTES=180
HIGHLIGHTS_YOUTUBE_NAVIGATION_TIMEOUT_SECONDS=90
# Facultatif : sans valeur, l’URL est calculée depuis l’identifiant de chaîne.
HIGHLIGHTS_YOUTUBE_STUDIO_UPLOAD_URL=

# Livraison WhatsApp Cloud API (sinon bouton wa.me + confirmation dans l’app)
WHATSAPP_AUTO_SEND_ENABLED=false
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
