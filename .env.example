# Local development example. Copy to .env and fill only what you need.
# Never commit the real .env.

JARVIS_MS_FOOTBALL_BRIDGE_TOKEN=

# Production/application secrets
DJANGO_SECRET_KEY=
TELEGRAM_BOT_TOKEN=

# Used only by the local PostgreSQL fallback when DATABASE_URL is not set.
POSTGRES_PASSWORD=

# Heroku/production normally supplies DATABASE_URL directly.
DATABASE_URL=
